  <maintainer email="rsdlab@todo.todo">rsdlab</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rosidl_default_generators</build_depend>

  <depend>collaboration_manipulation_message</depend>
